# Скопируйте в .env для локальной разработки backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schedule_dev?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Redis для очереди BullMQ. Если не задан — генерация выполняется в процессе API
REDIS_URL=redis://localhost:6379
# Python-сервис OR-Tools CP-SAT. Если недоступен — используется встроенный эвристический генератор
SOLVER_URL=http://localhost:8000
SOLVER_MODE=auto
