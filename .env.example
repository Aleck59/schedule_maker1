# Переменные окружения docker compose. Скопируйте в .env и измените секреты.

# Порт веб-интерфейса на хосте и публичный адрес (для CORS)
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# PostgreSQL
POSTGRES_DB=schedule
POSTGRES_USER=schedule
POSTGRES_PASSWORD=schedule

# JWT: обязательно замените на длинные случайные строки (например, openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Решатель: auto — OR-Tools CP-SAT с резервным эвристическим алгоритмом; cp-sat; heuristic
SOLVER_MODE=auto

# Заполнить пустую базу демонстрационными данными при первом запуске
SEED_DEMO=true

# Образы: локальная сборка (schedule-maker/*:local) или опубликованные релизы
# IMAGE_REGISTRY=ghcr.io/<владелец>/schedule-maker
# IMAGE_TAG=1.0.0
